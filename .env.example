# OpenAI 兼容端点(留空则只有回放模式可用)
# 真实调用总开关:默认关闭;未开启时 --model openai / API model="openai" 一律拒绝
PATCHPILOT_LLM_ENABLED=false
PATCHPILOT_LLM_BASE_URL=
PATCHPILOT_LLM_API_KEY=
PATCHPILOT_LLM_MODEL=gpt-4o-mini
# 单次请求上限(防失控花费)
PATCHPILOT_LLM_MAX_TOKENS=4096
PATCHPILOT_LLM_TIMEOUT_SECONDS=120
PATCHPILOT_LLM_MAX_RETRIES=1
# 单任务累计 token 预算(0=不限制)
PATCHPILOT_TOKEN_BUDGET=200000
# 可选:Redis(PATCHPILOT_REDIS_URL=redis://localhost:6379/0)
PATCHPILOT_REDIS_URL=
# 可选:Docker 执行器镜像
PATCHPILOT_DOCKER_IMAGE=python:3.11-slim
